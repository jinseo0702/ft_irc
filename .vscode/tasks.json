{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug clang",
            "type": "shell",
            "command": "make",
            "args": ["debug", "CXX=clang++"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "options": {
                "env": {
                    "CXX": "clang++"
                }
            }
        },
        {
            "label": "clean",
            "type": "shell", 
            "command": "make",
            "args": ["clean"]
        }
    ]
}